---
const experiences = [
  {
    role: 'Desenvolvedor Backend — Voluntário',
    company: 'Softwares for You',
    // TODO: confirmar data final. CV indica "Presente"; GitHub indica "Jan–Jun 2026".
    period: 'jan/2026 – jun/2026',
    location: 'remoto',
    summary:
      'Desenvolvimento backend voluntário em uma plataforma SaaS B2B em produção, com Node.js, Fastify, TypeScript, Prisma e PostgreSQL.',
    deliverables: [
      'APIs RESTful com Node.js, Fastify e TypeScript, com modelagem de dados via Prisma ORM e PostgreSQL.',
      'Autenticação stateless com JWT em cookies seguros e controle de acesso por papéis (RBAC) para múltiplos perfis de usuário.',
      'Regras de negócio para dashboards administrativos com validação de entrada via Zod, preservando a integridade dos dados nos endpoints.',
    ],
  },
];
---

<section class="section" id="experience" data-animate>
  <div class="container">
    <p class="section-label">experiência</p>

    <h2 class="section-title">Onde já apliquei</h2>

    <div class="exp-list">
      {
        experiences.map((exp) => (
          <article class="exp-item">
            <div class="exp-head">
              <div>
                <h3 class="exp-role">{exp.role}</h3>
                <p class="exp-company">
                  {exp.company} <span class="exp-sep">·</span> {exp.location}
                </p>
              </div>
              <span class="exp-period">{exp.period}</span>
            </div>

            <p class="exp-summary">{exp.summary}</p>

            <ul class="exp-deliverables">
              {exp.deliverables.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .exp-list {
    border-top: 1px solid var(--border);
  }

  .exp-item {
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
  }

  .exp-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .exp-role {
    font-size: var(--text-entry);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .exp-company {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }

  .exp-sep {
    color: var(--text-muted);
  }

  .exp-period {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .exp-summary {
    font-size: var(--text-body);
    color: var(--text-secondary);
    max-width: 68ch;
    margin-bottom: 1.25rem;
  }

  .exp-deliverables {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .exp-deliverables li {
    position: relative;
    padding-left: 1.25rem;
    font-size: var(--text-body);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 68ch;
  }

  .exp-deliverables li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }
</style>
