---
const stack = ['Java 21', 'Spring Boot', 'PostgreSQL', 'RabbitMQ', 'Docker'];
const services = [
  {
    name: 'OrderFlow',
    desc: 'pedidos orientados a eventos · saga + outbox',
    url: 'https://web.proudpond-c6cb94c4.brazilsouth.azurecontainerapps.io/login',
  },
  {
    name: 'Support Ticket API',
    desc: 'REST + JWT · Swagger',
    url: 'https://support-ticket-api-upaj.onrender.com/api/swagger-ui/index.html',
  },
];
---

<section class="hero" id="hero">
  <div class="container hero-inner">
    <div class="hero-left">
      <p class="hero-tag"><span class="dot"></span> backend · remoto · aberto a vaga júnior</p>
      <h1 class="hero-name">Nicolas Cajueiro</h1>
      <p class="hero-role">Desenvolvedor Backend · Java &amp; Spring Boot</p>
      <p class="hero-description">
        Construo APIs REST e sistemas assíncronos com mensageria, retry e DLQ.
        Os projetos abaixo estão no ar e com código aberto.
      </p>

      <ul class="stack-badges">
        {stack.map((s) => <li>{s}</li>)}
      </ul>

      <div class="hero-actions">
        <a href="/cv-att.pdf" download class="btn-primary">baixar CV</a>
        <a href="#projects" class="btn-ghost">ver projetos</a>
        <a href="#contact" class="btn-ghost">contato</a>
      </div>

      <div class="hero-socials">
        <a href="https://github.com/DevNic0las" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/nicolas-cajueiro-6b4617273/" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="mailto:nicolascajueiro098@gmail.com">e-mail ↗</a>
      </div>
    </div>

    <aside class="panel" aria-label="Projetos no ar">
      <p class="panel-title">// projetos no ar</p>
      {services.map((s) => (
        <a href={s.url} target="_blank" rel="noopener" class="svc" data-ping={s.url}>
          <span class="svc-dot"></span>
          <span class="svc-body">
            <strong>{s.name}</strong>
            <small>{s.desc}</small>
          </span>
          <span class="svc-state" aria-live="polite">verificando…</span>
        </a>
      ))}
      <p class="panel-note">hospedagem gratuita: o primeiro acesso pode acordar o serviço (cold start).</p>
      <a href="#projects" class="panel-more">todos os projetos ↓</a>
    </aside>
  </div>
</section>

<script>
  const services = document.querySelectorAll<HTMLElement>('[data-ping]');

  services.forEach((el) => {
    const state = el.querySelector<HTMLElement>('.svc-state');
    if (!state) return;

    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 8000);

    fetch(el.dataset.ping!, { mode: 'no-cors', signal: ctrl.signal })
      .then(() => {
        el.dataset.state = 'up';
        state.textContent = 'no ar';
      })
      .catch(() => {
        el.dataset.state = 'down';
        state.textContent = 'acordando…';
        el.title = 'Sem resposta em 8s — pode estar em cold start. Abra para acordar o serviço.';
      })
      .finally(() => clearTimeout(timer));
  });
</script>

<style>
  .hero { min-height: 100vh; display: flex; align-items: center; padding-top: 5rem; }
  .hero-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: center; }
  @media (max-width: 860px) { .hero-inner { grid-template-columns: 1fr; } }

  .hero-tag { display: flex; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: var(--text-meta); letter-spacing: .08em; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 1.5rem; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }

  .hero-name { font-size: var(--text-display); font-weight: 500; letter-spacing: -0.035em; line-height: 1.02; margin-bottom: .6rem; color: var(--text-primary); }
  .hero-role { font-size: clamp(1.1rem, 2.4vw, 1.3rem); font-weight: 500; color: var(--text-primary); margin-bottom: 1rem; }
  .hero-description { max-width: 52ch; color: var(--text-secondary); font-size: var(--text-body); line-height: 1.7; margin-bottom: 1.5rem; }

  .stack-badges { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; padding: 0; margin: 0 0 2rem; }
  .stack-badges li { font-family: var(--font-mono); font-size: var(--text-meta); letter-spacing: .04em; padding: .3rem .7rem; border: 1px solid var(--border); border-radius: 2px; color: var(--text-secondary); }

  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 1.75rem; }
  .btn-primary, .btn-ghost { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .06em; padding: .65rem 1.4rem; border-radius: 2px; transition: opacity .2s, border-color .2s, color .2s; }
  .btn-primary { background: var(--accent); color: #08140c; font-weight: 600; }
  .btn-primary:hover { opacity: .85; }
  .btn-ghost { border: 1px solid var(--border); color: var(--text-secondary); }
  .btn-ghost:hover { border-color: var(--border-hover); color: var(--text-primary); }

  .hero-socials { display: flex; flex-wrap: wrap; gap: 1.5rem; font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }
  .hero-socials a { display: inline-flex; align-items: center; min-height: 44px; }
  .hero-socials a:hover { color: var(--text-primary); }

  .panel { border: 1px solid var(--border); border-radius: 4px; padding: 1.25rem; display: flex; flex-direction: column; gap: .75rem; }
  .panel-title { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); letter-spacing: .08em; }
  .svc { display: flex; align-items: center; gap: .75rem; min-height: 44px; padding: .85rem; border: 1px solid var(--border); border-radius: 3px; transition: border-color .2s; }
  .svc:hover { border-color: var(--border-hover); }
  .svc-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--text-muted); flex-shrink: 0; }
  .svc[data-state='up'] .svc-dot { background: var(--accent); box-shadow: 0 0 8px #4ade8099; }
  .svc[data-state='down'] .svc-dot { background: #facc15; }
  .svc-body { display: flex; flex-direction: column; flex: 1; }
  .svc-body strong { font-weight: 500; color: var(--text-primary); font-size: 14px; }
  .svc-body small { color: var(--text-muted); font-size: 12px; }
  .svc-state { font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary); }
  .panel-more { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); margin-top: .25rem; }
  .panel-more:hover { color: var(--text-primary); }
  .panel-note { font-family: var(--font-mono); font-size: 10px; line-height: 1.5; color: var(--text-muted); opacity: .8; }

  @media (max-width: 480px) {
    .hero { padding-top: 6rem; }
    .hero-actions { gap: .5rem; }
    .btn-primary, .btn-ghost { padding: .65rem 1rem; flex: 1 1 auto; }
    .hero-socials { gap: 1rem; }
    .panel { padding: 1rem; }
  }
</style>